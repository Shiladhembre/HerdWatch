APP_NAME=Livestock Disease Surveillance API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://livestock:CHANGE_ME@localhost:5432/livestock_db
POSTGRES_USER=livestock
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=livestock_db
JWT_SECRET_KEY=CHANGE_ME_USE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
NASA_POWER_BASE_URL=https://power.larc.nasa.gov
SYMPTOM_MODEL_PATH=models/symptom_disease_model.pkl
SYMPTOM_FEATURES_PATH=models/symptom_feature_columns.pkl
SYMPTOM_LABEL_ENCODER_PATH=models/disease_label_encoder.pkl
OUTBREAK_MODEL_PATH=models/outbreak_risk_model.pkl
MODEL_METADATA_PATH=models/model_metadata.json
UPLOAD_DIR=uploads
REDIS_URL=
ENABLE_MODEL_CONFIDENCE=false
TRUST_MODEL_ARTIFACTS=false
ALLOW_DEMO_SEED=false
MAX_UPLOAD_BYTES=5242880
IMAGE_MODEL_PATH=models/cattle_image/cattle_disease_image_model.keras
IMAGE_CLASSES_PATH=models/cattle_image/cattle_disease_classes.json
IMAGE_MAX_UPLOAD_BYTES=10485760
IMAGE_MAX_PIXELS=20000000
IMAGE_MODEL_CONFIDENCE_THRESHOLD=0.70
